# A systemd user unit that keeps the daemon running. See README.md next to this file.
[Unit]
Description=harness-bridge daemon

[Service]
ExecStart=__BRIDGED__
Restart=on-failure
# systemd starts programs with a bare PATH. The daemon starts the adapters, and they start
# the harnesses: every one of them has to be found from here.
Environment=PATH=__PATH__

[Install]
WantedBy=default.target
